{
  "name": "jobot",
  "version": "1.0.0",
  "description": "Autonomous Job Application Operating System - Dual Stack Package (Python backend + Tauri 2/React desktop GUI)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "prettier --check \"tests/npm/**/*.{js,ts,json}\" \"gui/src/**/*.{js,jsx}\" \"gui/tests/**/*.{js,jsx}\" \"gui/src-tauri/**/*.json\" package.json gui/package.json",
    "format": "prettier --write \"tests/npm/**/*.{js,ts,json}\" \"gui/src/**/*.{js,jsx}\" \"gui/tests/**/*.{js,jsx}\" \"gui/src-tauri/**/*.json\" package.json gui/package.json",
    "test": "vitest run",
    "build:gui": "vite build gui",
    "build:sidecar": "python scripts/build_sidecar.py",
    "tauri:dev": "cd gui && tauri dev",
    "tauri:build": "cd gui && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.2.5",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
