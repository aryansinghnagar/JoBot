{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JoBot",
  "version": "0.2.0",
  "identifier": "com.jobot.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix .. run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JoBot Desktop",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
